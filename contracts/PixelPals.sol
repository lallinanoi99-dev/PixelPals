pragma solidity ^0.8.20;

import {ERC721} from "@openzeppelin/contracts/token/ERC721/ERC721.sol";
import {Strings} from "@openzeppelin/contracts/utils/Strings.sol";
import {Base64} from "@openzeppelin/contracts/utils/Base64.sol";

/// @title Pixel Pals art — draws a pal as a 16×16 pixel SVG and wraps it in token JSON.
/// @dev Pure functions only: no storage, no owner. Deployed by the PixelPals constructor.
contract PixelPalsArt {
    using Strings for uint256;

    /// @dev What a pal looks like right now.
    struct Look {
        uint256 species;
        uint256 stage;
        uint256 palette;
        uint256 pattern;
        uint256 accessory;
        uint256 mood;
        uint256 careDays;
    }

    /// @notice Full data: URI (base64 JSON with a base64 SVG image) for pal `id`.
    function tokenURI(uint256 id, string calldata name, Look calldata l) external pure returns (string memory) {
        bytes memory json = abi.encodePacked(
            '{"name":"',
            bytes(name).length > 0 ? string.concat(name, unicode" · ") : "",
            "Pixel Pal #", id.toString(),
            '","description":"A tiny pixel pet living on BOT Chain. Feed it, play with it, tuck it in, and watch it grow. Drawn entirely by its smart contract.","image":"data:image/svg+xml;base64,',
            Base64.encode(_svg(l.species, l.stage, l.palette, l.pattern, l.accessory, l.mood)),
            '","attributes":['
        );
        // Species, Stage, Palette, Pattern, Accessory, Mood (word indexes into WORDS)
        uint256[6] memory v = [l.species, 3 + l.stage, 7 + l.palette, 15 + l.pattern, 19 + l.accessory, 24 + l.mood];
        for (uint256 i; i < 6; i++) {
            json = abi.encodePacked(json, '{"trait_type":"', _word(27 + i), '","value":"', _word(v[i]), '"},');
        }
        json = abi.encodePacked(json, '{"trait_type":"Care days","display_type":"number","value":', l.careDays.toString(), "}]}");
        return string.concat("data:application/json;base64,", Base64.encode(json));
    }

    /// @notice Just the SVG image for a look.
    function svg(Look calldata l) external pure returns (string memory) {
        return string(_svg(l.species, l.stage, l.palette, l.pattern, l.accessory, l.mood));
    }

    /// @dev Word `k` of the "|"-separated WORDS list.
    function _word(uint256 k) private pure returns (string memory) {
        bytes memory w = WORDS;
        uint256 i;
        while (k > 0) {
            if (w[i++] == "|") k--;
        }
        uint256 j = i;
        while (j < w.length && w[j] != "|") j++;
        bytes memory out = new bytes(j - i);
        for (uint256 x; x < out.length; x++) out[x] = w[i + x];
        return string(out);
    }

    // ---- art

    bytes private constant WORDS =
        "Cat|Dino|Blob|Egg|Baby|Teen|Adult|Strawberry Milk|Mint Chip|Lavender Haze|Peach Soda|Sky Bubble|Lemon Drop|Cotton Candy|Matcha Latte|Plain|Spots|Stripes|Sparkles|None|Bow|Tiny hat|Round glasses|Flower|Happy|Okay|Sad|Species|Stage|Palette|Pattern|Accessory|Mood";

    // <art> generated by tools/gen-sprites.mjs from assets/sprites.js — do not edit by hand
    bytes private constant SPRITES = hex"";
    bytes private constant PALETTE_HEX = "FFF0F5FFC8DDFF8FB8FFFFFFEEFBF3C8F2DC7FD6A86B4F3AF5F0FFD9C8FFA98BF0FFFFFFFFF4ECFFD6BAFFA77FFFF1A8EEF6FFBDE0FE7FB8F0FFFFFFFFFBE6FFF1A8F5CE4EFFB3A7FDF0FAE8D5F5FFB3D9BDE0FEF3F7EACFE3B596B972FBF7F0";
    bytes private constant OVERLAYS = hex"";
    bytes private constant OVERLAY_INDEX = hex"00070a101b22262c35";
    bytes private constant OVERLAY_COLORS = "3A3150FF8FB87FB8F0FFFFFFFF6FA3D9487F2B2440F5CE4E7FD6A8A9B4CFC5CEE3";
    // </art>

    /// @dev Six hex characters from a hex string: colour `i` of `table`.
    function _hex(bytes memory table, uint256 i) private pure returns (bytes memory c) {
        c = new bytes(6);
        for (uint256 k; k < 6; k++) c[k] = table[i * 6 + k];
    }

    /// @dev One horizontal run of pixels. `y` may be negative (overlays above the head).
    function _rect(uint256 x, int256 y, uint256 w, bytes memory color, bool blush) private pure returns (bytes memory) {
        return abi.encodePacked(
            '<rect x="', x.toString(),
            '" y="', y < 0 ? string.concat("-", uint256(-y).toString()) : uint256(y).toString(),
            '" width="', w.toString(), '" height="1" fill="#', color,
            blush ? '" opacity=".7"/>' : '"/>'
        );
    }

    /// @dev Opens a <g> moved by (dx, dy); overlay coordinates are relative to it.
    function _group(uint256 dx, uint256 dy) private pure returns (bytes memory) {
        return abi.encodePacked('<g transform="translate(', dx.toString(), " ", dy.toString(), ')">');
    }

    /// @dev The rects of overlay `k`: 0-2 faces (happy/okay/sad), 3 glasses, 4 bow, 5 hat, 6 flower, 7 rain cloud.
    function _overlay(uint256 k) private pure returns (bytes memory out) {
        bytes memory o = OVERLAYS;
        bytes memory idx = OVERLAY_INDEX;
        bytes memory colors = OVERLAY_COLORS;
        for (uint256 r = uint8(idx[k]); r < uint8(idx[k + 1]); r++) {
            uint256 c = uint8(o[r * 4 + 3]);
            int256 y = int256(uint256(uint8(o[r * 4 + 1]))) - 16;
            out = abi.encodePacked(out, _rect(uint8(o[r * 4]), y, uint8(o[r * 4 + 2]), _hex(colors, c & 0x7f), c >= 0x80));
        }
    }

    function _svg(uint256 species, uint256 stage, uint256 palette, uint256 pattern, uint256 accessory, uint256 mood)
        private
        pure
        returns (bytes memory out)
    {
        bytes memory sprites = SPRITES;
        uint256 base = (species * 4 + stage) * 66;
        bytes memory pal = PALETTE_HEX;

        out = abi.encodePacked(
            '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" shape-rendering="crispEdges"><rect width="20" height="20" fill="#',
            _hex(pal, palette * 4),
            '"/><rect x="5" y="19" width="10" height="1" fill="#3A3150" opacity=".15"/><g transform="translate(2 3)">'
        );
        out = abi.encodePacked(out, _body(sprites, base, palette, pattern));
        if (stage > 0) {
            // glasses go under the face so the eyes show through the lenses
            out = abi.encodePacked(out, _group(0, uint8(sprites[base + 64])), accessory == 3 ? _overlay(3) : bytes(""), _overlay(mood), "</g>");
            if (accessory == 1 || accessory == 2 || accessory == 4) {
                // bow → 4, hat → 5, flower → 6
                out = abi.encodePacked(out, _group(0, uint8(sprites[base + 65])), _overlay(accessory == 4 ? 6 : accessory + 3), "</g>");
            }
        }
        out = abi.encodePacked(out, "</g>");
        if (mood == 2) {
            uint256 headY = uint8(sprites[base + 65]);
            out = abi.encodePacked(out, _group(2, headY > 3 ? headY - 3 : 0), _overlay(7), "</g>");
        }
        out = abi.encodePacked(out, "</svg>");
    }

    /// @dev The sprite itself: one <rect> per horizontal run of the same colour.
    function _body(bytes memory sprites, uint256 base, uint256 palette, uint256 pattern) private pure returns (bytes memory out) {
        for (uint256 y; y < 16; y++) {
            uint256 x;
            while (x < 16) {
                uint256 c = _code(sprites, base, pattern, x, y);
                uint256 w = 1;
                while (x + w < 16 && _code(sprites, base, pattern, x + w, y) == c) w++;
                if (c != 0) out = abi.encodePacked(out, _run(x, y, w, c, palette));
                x += w;
            }
        }
    }

    function _run(uint256 x, uint256 y, uint256 w, uint256 c, uint256 palette) private pure returns (bytes memory) {
        return _rect(x, int256(y), w, c == 1 ? bytes("3A3150") : _hex(PALETTE_HEX, palette * 4 + c - 1), false);
    }

    /// @dev 0 empty, 1 outline, 2 body, 3 accent, 4 pattern (a body pixel covered by the pattern).
    function _code(bytes memory sprites, uint256 base, uint256 pattern, uint256 x, uint256 y) private pure returns (uint256) {
        uint256 v = (uint8(sprites[base + y * 4 + x / 4]) >> (6 - 2 * (x % 4))) & 3;
        if (v != 2) return v;
        if (pattern == 1 && ((x % 4 == 1 && y % 4 == 1) || (x % 4 == 3 && y % 4 == 3))) return 4;
        if (pattern == 2 && y % 3 == 0) return 4;
        if (pattern == 3 && (x * 3 + y * 5) % 11 == 0) return 4;
        return 2;
    }
}

/// @title Pixel Pals — tiny pixel pets that live on BOT Chain.
/// @notice Hatch a pal, feed / play / sleep once a day, and it grows Egg → Baby → Teen → Adult.
///         The art is drawn by this contract: tokenURI returns JSON + SVG, no IPFS.
/// @dev Trait randomness uses block.prevrandao and is NOT secure randomness. That is fine here:
///      traits are cosmetic only. No payments, no admin, no royalties.
///      The SVG + JSON drawing lives in PixelPalsArt, which the constructor deploys, so each
///      contract stays under the 24 KB size limit even when compiled without the optimizer.
contract PixelPals is ERC721 {

    uint256 public constant MAX_SUPPLY = 677;
    uint8 public constant MAX_PER_WALLET = 3;
    uint8 public constant MAX_NAME = 16;

    struct Pal {
        uint8 species; // 0 Cat, 1 Dino, 2 Blob
        uint8 palette; // 0..7
        uint8 pattern; // 0 Plain, 1 Spots, 2 Stripes, 3 Sparkles
        uint8 accessory; // 0 None, 1 Bow, 2 Tiny hat, 3 Round glasses, 4 Flower
        uint32 careDays;
        uint32 lastCareDay; // day of the last full care day (hatch day to start)
        uint32 lastFed;
        uint32 lastPlayed;
        uint32 lastSlept;
        uint64 bornAt;
        string name;
    }

    mapping(uint256 => Pal) private _pals;
    mapping(address => uint8) public minted;
    /// @notice Day the pal was last renamed (one rename per day).
    mapping(uint256 => uint32) public lastNamed;
    /// @dev Bit i set = a full care day on (lastCareDay - i). Read it with historyOf().
    mapping(uint256 => uint64) private _history;

    uint256 private _hatched;

    event Hatched(uint256 indexed id, address indexed owner, uint8 species);
    event Cared(uint256 indexed id, uint8 action, uint32 day);
    event CareDay(uint256 indexed id, uint32 careDays);
    event Evolved(uint256 indexed id, uint8 stage);
    event Named(uint256 indexed id, string name);

    error SoldOut();
    error WalletFull();
    error NotOwner();
    error AlreadyDone();
    error BadName();
    error NameCooldown();

    /// @notice The helper contract that draws every pal (deployed by this constructor).
    PixelPalsArt public immutable art;

    constructor() ERC721("Pixel Pals", "PALS") {
        art = new PixelPalsArt();
    }

    // ------------------------------------------------------------------ writes

    /// @notice Hatch a new pal. Free (gas only). Ids start at 1.
    function hatch() external returns (uint256 id) {
        if (_hatched >= MAX_SUPPLY) revert SoldOut();
        if (minted[msg.sender] >= MAX_PER_WALLET) revert WalletFull();
        id = ++_hatched;
        minted[msg.sender]++;

        uint256 r = uint256(keccak256(abi.encodePacked(block.prevrandao, msg.sender, id)));
        Pal storage p = _pals[id];
        p.species = uint8(r % 3);
        p.palette = uint8((r >> 8) % 8);
        p.pattern = uint8((r >> 16) % 4);
        p.accessory = uint8((r >> 24) % 5);
        p.lastCareDay = today();
        p.bornAt = uint64(block.timestamp);

        _mint(msg.sender, id);
        emit Hatched(id, msg.sender, p.species);
    }

    function feed(uint256 id) external { _care(id, 0); }
    function play(uint256 id) external { _care(id, 1); }
    function sleep(uint256 id) external { _care(id, 2); }

    /// @notice Name your pal: 1–16 letters, numbers or spaces (not starting with a space). Once per day.
    function setName(uint256 id, string calldata newName) external {
        if (ownerOf(id) != msg.sender) revert NotOwner();
        bytes calldata b = bytes(newName);
        if (b.length == 0 || b.length > MAX_NAME || b[0] == " ") revert BadName();
        for (uint256 i; i < b.length; i++) {
            bytes1 c = b[i];
            if (!((c >= "a" && c <= "z") || (c >= "A" && c <= "Z") || (c >= "0" && c <= "9") || c == " ")) revert BadName();
        }
        uint32 d = today();
        if (lastNamed[id] == d) revert NameCooldown();
        lastNamed[id] = d;
        _pals[id].name = newName;
        emit Named(id, newName);
    }

    function _care(uint256 id, uint8 action) private {
        if (ownerOf(id) != msg.sender) revert NotOwner();
        Pal storage p = _pals[id];
        uint32 d = today();
        if (action == 0) {
            if (p.lastFed == d) revert AlreadyDone();
            p.lastFed = d;
        } else if (action == 1) {
            if (p.lastPlayed == d) revert AlreadyDone();
            p.lastPlayed = d;
        } else {
            if (p.lastSlept == d) revert AlreadyDone();
            p.lastSlept = d;
        }
        emit Cared(id, action, d);

        if (p.lastFed == d && p.lastPlayed == d && p.lastSlept == d) {
            uint8 before = _stage(p.careDays);
            uint32 gap = d - p.lastCareDay;
            _history[id] = (gap >= 64 ? 0 : _history[id] << gap) | 1;
            p.careDays += 1;
            p.lastCareDay = d;
            emit CareDay(id, p.careDays);
            uint8 s = _stage(p.careDays);
            if (s != before) emit Evolved(id, s);
        }
    }

    // ------------------------------------------------------------------ views

    /// @notice Current day number (UTC days since 1970).
    function today() public view returns (uint32) {
        return uint32(block.timestamp / 1 days);
    }

    function totalHatched() external view returns (uint256) {
        return _hatched;
    }

    function getPal(uint256 id) external view returns (Pal memory) {
        _requireOwned(id);
        return _pals[id];
    }

    /// @notice 0 Egg, 1 Baby (1+ care days), 2 Teen (7+), 3 Adult (14+).
    function stageOf(uint256 id) external view returns (uint8) {
        _requireOwned(id);
        return _stage(_pals[id].careDays);
    }

    /// @notice 0 Happy (cared today or yesterday), 1 Okay (1 day missed), 2 Sad (2+ days missed).
    function moodOf(uint256 id) external view returns (uint8) {
        _requireOwned(id);
        return _mood(_pals[id].lastCareDay);
    }

    /// @notice Care history aligned to today: bit i set = full care day i days ago.
    function historyOf(uint256 id) external view returns (uint64) {
        _requireOwned(id);
        uint32 gap = today() - _pals[id].lastCareDay;
        return gap >= 64 ? 0 : _history[id] << gap;
    }

    /// @notice All pal ids owned by `owner` (loops over at most 677 ids; for off-chain reads).
    function palsOf(address owner) external view returns (uint256[] memory ids) {
        uint256 n = balanceOf(owner);
        ids = new uint256[](n);
        uint256 k;
        for (uint256 id = 1; id <= _hatched && k < n; id++) {
            if (_ownerOf(id) == owner) ids[k++] = id;
        }
    }

    /// @notice Pals `start`..`start+count-1` with their owners, for the Playground gallery.
    function palsRange(uint256 start, uint256 count) external view returns (Pal[] memory list, address[] memory owners) {
        if (start == 0) start = 1;
        uint256 end = start + count > _hatched + 1 ? _hatched + 1 : start + count;
        uint256 n = end > start ? end - start : 0;
        list = new Pal[](n);
        owners = new address[](n);
        for (uint256 i; i < n; i++) {
            list[i] = _pals[start + i];
            owners[i] = _ownerOf(start + i);
        }
    }

    /// @notice JSON metadata with an on-chain SVG image, redrawn on every call (stage and mood are live).
    function tokenURI(uint256 id) public view override returns (string memory) {
        _requireOwned(id);
        Pal storage p = _pals[id];
        return art.tokenURI(
            id,
            p.name,
            PixelPalsArt.Look(p.species, _stage(p.careDays), p.palette, p.pattern, p.accessory, _mood(p.lastCareDay), p.careDays)
        );
    }

    // ------------------------------------------------------------------ internals

    function _stage(uint32 careDays) private pure returns (uint8) {
        if (careDays >= 14) return 3;
        if (careDays >= 7) return 2;
        if (careDays >= 1) return 1;
        return 0;
    }

    function _mood(uint32 lastCareDay) private view returns (uint8) {
        uint32 gap = today() - lastCareDay;
        if (gap <= 1) return 0;
        if (gap == 2) return 1;
        return 2;
    }
}
